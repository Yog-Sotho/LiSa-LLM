{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug, warnings as errors",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "LISA_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "Debug + AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "dev",
      "cacheVariables": {
        "LISA_SANITIZERS": "address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "Debug + ThreadSanitizer (engine instrumented too, OpenMP off)",
      "inherits": "dev",
      "cacheVariables": {
        "LISA_SANITIZERS": "thread",
        "LLAMA_SANITIZE_THREAD": "ON",
        "GGML_SANITIZE_THREAD": "ON",
        "GGML_OPENMP": "OFF"
      }
    },
    {
      "name": "coverage",
      "displayName": "Debug with coverage instrumentation (gcovr report)",
      "inherits": "dev",
      "cacheVariables": {
        "LISA_COVERAGE": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer targets + ASan/UBSan (needs CC=clang CXX=clang++)",
      "inherits": "asan-ubsan",
      "cacheVariables": {
        "LISA_FUZZ": "ON",
        "LISA_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release (portable CPU build)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "LISA_WARNINGS_AS_ERRORS": "ON",
        "LISA_NATIVE": "OFF"
      }
    },
    {
      "name": "portable",
      "displayName": "Release binary for distribution (static deps except glibc)",
      "inherits": "release",
      "cacheVariables": {
        "LISA_PORTABLE": "ON",
        "GGML_OPENMP": "OFF"
      }
    },
    {
      "name": "cuda",
      "displayName": "Release with CUDA offload",
      "inherits": "release",
      "cacheVariables": {
        "LISA_CUDA": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "fuzz", "configurePreset": "fuzz" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "release", "configurePreset": "release" },
    { "name": "portable", "configurePreset": "portable" },
    { "name": "cuda", "configurePreset": "cuda" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev" },
    { "name": "coverage", "inherits": "base", "configurePreset": "coverage" },
    {
      "name": "asan-ubsan",
      "inherits": "base",
      "configurePreset": "asan-ubsan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "configurePreset": "tsan",
      "environment": { "TSAN_OPTIONS": "halt_on_error=1" }
    },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "portable", "inherits": "base", "configurePreset": "portable" }
  ]
}
